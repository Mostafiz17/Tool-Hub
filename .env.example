# ToolHub environment (copy to .env — never commit real secrets)
# MongoDB connection used for auth, favorites, and preferences
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=app_db
# Secret used to sign session cookies — use a long random value in production
AUTH_SECRET=replace-with-a-long-random-string
# Optional: no key needed — currency uses the free open.er-api.com service via /api/currency
NODE_ENV=development
